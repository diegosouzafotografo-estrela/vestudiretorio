---
interface Props { title: string; description?: string; }
const { title, description = 'Descubra fornecedores de vestuário atacadista com dados claros para comprar melhor.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2b2522" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style is:global>@import '../styles/globals.css';</style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Pular para conteúdo</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label="VestuDiretório, página inicial">
          <span class="brand__mark">V</span><span>Vestu<span class="brand__accent">Diretório</span></span>
        </a>
        <nav class="site-nav" aria-label="Navegação principal">
          <a href="/fornecedores">Para fornecedores</a>
          <a class="nav-cta" href="/#directory">Encontrar fornecedor <span>↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer id="about" class="site-footer">
      <div class="container site-footer__inner">
        <span class="brand brand--footer"><span class="brand__mark">V</span><span>Vestu<span class="brand__accent">Diretório</span></span></span>
        <span>Dados para quem compra no atacado.</span>
        <span>© 2026 Elo Firme</span>
      </div>
    </footer>
  </body>
</html>
